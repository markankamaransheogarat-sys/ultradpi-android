<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ UltraDPI"
            android:textColor="#38BDF8"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Автоматический обход блокировок ТСПУ"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/centerBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ОТКЛЮЧЕНО"
            android:textColor="#64748B"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Нажмите большую кнопку для старта"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/circle_button"
            android:elevation="8dp"
            android:text="ВКЛЮЧИТЬ"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/presetBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/centerBlock"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Режим обхода (для вашего провайдера):"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerPreset"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/btn_dropdown"
            android:backgroundTint="#38BDF8"
            android:popupBackground="#1E293B" />

        <TextView
            android:id="@+id/tvPresetHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Универсальная нарезка SNI + фейковые QUIC пакеты"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:text="YouTube 4K • Discord Voice • ChatGPT • Claude • Battlefield\nБез удаленных серверов • Локальная десинхронизация"
        android:textColor="#475569"
        android:textSize="11sp" />

</RelativeLayout>

