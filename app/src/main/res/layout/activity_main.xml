<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ UltraDPI"
                android:textColor="#38BDF8"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Обход ТСПУ без сторонних серверов"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОТКЛЮЧЕНО"
                android:textColor="#64748B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Нажмите для включения защиты"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnToggle"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:background="@drawable/circle_button"
                android:elevation="8dp"
                android:text="ВКЛЮЧИТЬ"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131B2E"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Режим обхода (для вашего оператора):"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerPreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@android:drawable/btn_dropdown"
                android:backgroundTint="#38BDF8"
                android:popupBackground="#1E293B" />

            <TextView
                android:id="@+id/tvPresetHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Быстрый сплит без задержек для сотовых сетей"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCustomArgs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="#1E293B"
                android:hint="-o1 -a1 -r-5+se"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B"
                android:textSize="13sp"
                android:padding="10dp"
                android:inputType="textMultiLine" />

            <CheckBox
                android:id="@+id/cbIpv6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:buttonTint="#38BDF8"
                android:text="Защита от утечки IPv6 (блокировать обход в 4G/LTE)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="YouTube 4K • Discord • ChatGPT • Claude\nЛокальная десинхронизация без ограничений скорости"
            android:textColor="#475569"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
